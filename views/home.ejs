<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ankit Kumar | Full Stack Developer</title>
  <meta name="description" content="Portfolio of Ankit Kumar - Full Stack Developer specializing in MERN Stack (MongoDB, Express.js, React.js, Node.js) and Java DSA.">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

  <!-- Navbar -->
  <%- include("include/navbar.ejs"); %>

  <!-- HERO SECTION -->
  <section class="hero-section" id="hero">
    <div class="hero-grid">
      <!-- Hero Left Text -->
      <div class="hero-content">
        <div class="liquid-badge">
          <div class="liquid-badge-pulse"></div>
          <span>Full Stack Developer | B.Tech CSE @ Parul University</span>
        </div>

        <h1 class="hero-title">
          Hi, I'm <span class="gradient-text-accent">Ankit Kumar</span>
        </h1>

        <div class="typewriter-box">
          &gt; <span id="typewriter-text"></span><span class="cursor-blink"></span>
        </div>

        <p class="hero-description">
          Computer Science Engineering student at Parul University proficient in building full-stack web applications using the <strong>MERN stack (MongoDB, Express.js, React.js, Node.js)</strong>, RESTful APIs, AI integrations, and Java Data Structures.
        </p>

        <div class="hero-cta">
          <button onclick="openResumeModal()" class="btn-liquid btn-liquid-primary">
            <i class="fas fa-file-pdf"></i> View & Download Resume
          </button>
          <a href="#projects" class="btn-liquid btn-liquid-secondary">
            <i class="fas fa-rocket"></i> View Projects
          </a>
          <a href="#contact" class="btn-liquid btn-liquid-secondary">
            <i class="fas fa-envelope"></i> Contact Me
          </a>
        </div>
      </div>

      <!-- Hero Right Visual - Morphing Photo Frame -->
      <div class="hero-visual">
        <div class="avatar-container avatar-morph-frame">
          <img src="/images/photo.png" alt="Ankit Kumar - Full Stack Developer" class="avatar-img">
        </div>

        <!-- Floating Glass Badges -->
        <div class="float-card float-card-1">
          <div class="float-icon">
            <i class="fas fa-layer-group"></i>
          </div>
          <div class="float-text">
            <h4>Full Stack Developer</h4>
            <p>MERN Stack & REST APIs</p>
          </div>
        </div>

        <div class="float-card float-card-2">
          <div class="float-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
            <i class="fas fa-graduation-cap"></i>
          </div>
          <div class="float-text">
            <h4>Parul University</h4>
            <p>B.Tech CSE (2023-2027)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Developer Code Terminal -->
    <div class="terminal-card">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <span class="terminal-title">ankit@fullstack-developer:~</span>
        <span style="font-size: 0.75rem; color: #64748b;">Node.js v25.8.0</span>
      </div>
      <div class="terminal-body">
        <p><span class="t-purple">const</span> <span class="t-blue">developer</span> = {</p>
        <p style="padding-left: 20px;"><span class="t-pink">name</span>: <span class="t-green">'Ankit Kumar'</span>,</p>
        <p style="padding-left: 20px;"><span class="t-pink">role</span>: <span class="t-green">'Full Stack Developer'</span>,</p>
        <p style="padding-left: 20px;"><span class="t-pink">stack</span>: <span class="t-green">'MERN Stack Technology (MongoDB, Express, React, Node)'</span>,</p>
        <p style="padding-left: 20px;"><span class="t-pink">university</span>: <span class="t-green">'Parul University, Vadodara, Gujarat (2023 - 2027)'</span>,</p>
        <p style="padding-left: 20px;"><span class="t-pink">frontend</span>: [<span class="t-yellow">'React.js'</span>, <span class="t-yellow">'HTML5'</span>, <span class="t-yellow">'CSS3'</span>, <span class="t-yellow">'Bootstrap'</span>],</p>
        <p style="padding-left: 20px;"><span class="t-pink">backend</span>: [<span class="t-yellow">'Node.js'</span>, <span class="t-yellow">'Express.js'</span>, <span class="t-yellow">'RESTful APIs'</span>],</p>
        <p style="padding-left: 20px;"><span class="t-pink">database</span>: [<span class="t-yellow">'MongoDB'</span>, <span class="t-yellow">'MySQL'</span>],</p>
        <p style="padding-left: 20px;"><span class="t-pink">leetCode</span>: <span class="t-green">'100+ DSA Solved'</span></p>
        <p>};</p>
      </div>
    </div>
  </section>

  <!-- Quick Stats Section -->
  <section class="stats-section">
    <div class="stats-grid">
      <div class="glass-card stat-card tilt-card">
        <div class="stat-number">Full Stack</div>
        <div class="stat-label">Web Developer</div>
      </div>

      <div class="glass-card stat-card tilt-card">
        <div class="stat-number">MERN</div>
        <div class="stat-label">Stack Technology</div>
      </div>

      <div class="glass-card stat-card tilt-card">
        <div class="stat-number">100+</div>
        <div class="stat-label">LeetCode Solved</div>
      </div>

      <div class="glass-card stat-card tilt-card">
        <div class="stat-number">2023-2027</div>
        <div class="stat-label">B.Tech CSE @ Parul Univ</div>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section class="about-section" id="about">
    <div class="section-header">
      <span class="section-subtitle">About Me</span>
      <h2 class="section-title">Full Stack Developer <span class="gradient-text-accent">Using MERN Stack</span></h2>
      <p class="section-desc">Computer Science & Engineering Student at Parul University, Vadodara, Gujarat (2023–2027).</p>
    </div>

    <div class="about-hero-grid">
      <div class="glass-card about-card tilt-card">
        <h3 style="font-size: 1.4rem; margin-bottom: 14px;">Professional Summary</h3>
        <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin-bottom: 16px;">
          Computer Science Engineering student with practical experience in full-stack web development as a <strong>Full Stack Developer using MERN stack technology (MongoDB, Express.js, React.js, Node.js)</strong>. Proficient in building web applications, RESTful APIs, and backend systems with strong fundamentals in Data Structures & Algorithms.
        </p>

        <h4 style="font-size: 1.1rem; font-weight: 700; margin: 18px 0 10px; color: var(--accent-primary);">
          <i class="fas fa-star" style="color: #f59e0b;"></i> Key Strengths & Technical Highlights:
        </h4>
        <ul style="padding-left: 20px; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.7; display: flex; flex-direction: column; gap: 8px;">
          <li><strong>MERN Stack Mastery:</strong> Building dynamic web portals with React.js frontend components, Express backend APIs, Node.js runtime, and MongoDB database architecture.</li>
          <li><strong>AI & Real-Time Tech:</strong> Integrated OpenAI API for automated interview analysis and implemented live video streaming using WebRTC and Socket.io.</li>
          <li><strong>API & Geolocation Integration:</strong> Integrated Google Maps API for location-based search and created REST APIs for government service platforms.</li>
          <li><strong>100+ LeetCode Solved:</strong> Solid foundation in Data Structures and Algorithms, Object-Oriented Programming, DBMS, OS, and Computer Networks.</li>
          <li><strong>Industry Certifications:</strong> Certified in Artificial Intelligence Fundamentals (IBM & Cisco), AWS Cloud Foundations, and Algorithm Design (CodeTantra).</li>
        </ul>

        <div style="margin-top: 24px;">
          <button onclick="openResumeModal()" class="btn-liquid btn-liquid-primary">
            <i class="fas fa-file-pdf"></i> View & Download Resume
          </button>
        </div>
      </div>

      <div class="glass-card about-card">
        <h3 style="font-size: 1.3rem; margin-bottom: 16px;">Education & Academic Details</h3>
        <div class="timeline">
          <div class="timeline-item">
            <span class="timeline-date">2023 - 2027</span>
            <h4 class="timeline-title">Parul University, Vadodara, Gujarat</h4>
            <p style="font-weight: 700; color: var(--accent-primary); font-size: 0.9rem;">B.Tech in Computer Science Engineering</p>
            <p class="timeline-desc">Coursework: Data Structures & Algorithms, Operating Systems, Computer Networks, Object-Oriented Programming, DBMS.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS SECTION -->
  <section class="skills-section" id="skills">
    <div class="section-header">
      <span class="section-subtitle">Technical Proficiency</span>
      <h2 class="section-title">MERN Stack & <span class="gradient-text-accent">Skills</span></h2>
      <p class="section-desc">Technologies, frameworks, databases, and core CS subjects from my official resume.</p>
    </div>

    <!-- Category Filter Buttons -->
    <div class="skills-filter">
      <button class="filter-btn active" data-filter="all">All Skills</button>
      <button class="filter-btn" data-filter="frontend">Frontend</button>
      <button class="filter-btn" data-filter="backend">Backend</button>
      <button class="filter-btn" data-filter="languages">Languages</button>
      <button class="filter-btn" data-filter="databases">Databases</button>
      <button class="filter-btn" data-filter="tools">Tools & Core CS</button>
    </div>

    <div class="skills-grid">
      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #61DAFB; background: #20232a;"><i class="fa-brands fa-react"></i></div>
        <span class="skill-title">React.js</span>
        <span class="skill-level-badge">Frontend</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="backend">
        <div class="skill-icon-wrap" style="color: #339933;"><i class="fa-brands fa-node-js"></i></div>
        <span class="skill-title">Node.js</span>
        <span class="skill-level-badge">Backend</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="backend">
        <div class="skill-icon-wrap" style="color: #4f46e5;"><i class="fa-solid fa-server"></i></div>
        <span class="skill-title">Express.js</span>
        <span class="skill-level-badge">Backend</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="databases">
        <div class="skill-icon-wrap" style="color: #13AA52;"><i class="fa-solid fa-database"></i></div>
        <span class="skill-title">MongoDB</span>
        <span class="skill-level-badge">Database</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #F7DF1E; background: #1e293b;"><i class="fa-brands fa-js"></i></div>
        <span class="skill-title">JavaScript</span>
        <span class="skill-level-badge">Languages</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #f89820;"><i class="fa-brands fa-java"></i></div>
        <span class="skill-title">Java & DSA</span>
        <span class="skill-level-badge">Languages</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #3776AB;"><i class="fa-brands fa-python"></i></div>
        <span class="skill-title">Python</span>
        <span class="skill-level-badge">Languages</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #00599C;"><i class="fa-solid fa-code"></i></div>
        <span class="skill-title">C Language</span>
        <span class="skill-level-badge">Languages</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #E34F26;"><i class="fa-brands fa-html5"></i></div>
        <span class="skill-title">HTML5</span>
        <span class="skill-level-badge">Frontend</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #1572B6;"><i class="fa-brands fa-css3-alt"></i></div>
        <span class="skill-title">CSS3 & Glass</span>
        <span class="skill-level-badge">Frontend</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #7952B3;"><i class="fa-brands fa-bootstrap"></i></div>
        <span class="skill-title">Bootstrap</span>
        <span class="skill-level-badge">Frontend</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="databases">
        <div class="skill-icon-wrap" style="color: #00758F;"><i class="fa-solid fa-database"></i></div>
        <span class="skill-title">MySQL</span>
        <span class="skill-level-badge">Database</span>
      </div>

      <div class="glass-card skill-card-modern tilt-card" data-category="tools">
        <div class="skill-icon-wrap" style="color: #f05032;"><i class="fa-brands fa-git-alt"></i></div>
        <span class="skill-title">Git & GitHub</span>
        <span class="skill-level-badge">Tools</span>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="projects-section" id="projects">
    <div class="section-header">
      <span class="section-subtitle">Portfolio Showcase</span>
      <h2 class="section-title">Featured MERN Stack <span class="gradient-text-accent">Projects</span></h2>
      <p class="section-desc">Full stack web applications built with MongoDB, Express.js, React.js, and Node.js.</p>
    </div>

    <div class="projects-grid">
      <% if (project && project.length > 0) { %>
        <% for(let p of project) { %>
          <div class="glass-card project-card-modern tilt-card">
            <div class="project-preview-box" style="background: <%= p.accentColor || 'linear-gradient(135deg, #6366f1, #3b82f6)' %>; display: flex; align-items: center; justify-content: center; position: relative;">
              <div style="font-size: 3.8rem; color: #ffffff; opacity: 0.9; text-shadow: 0 10px 20px rgba(0,0,0,0.2);">
                <i class="<%= p.iconClass || 'fas fa-laptop-code' %>"></i>
              </div>
              <span class="project-overlay-badge"><%= p.category || 'MERN Stack' %></span>
            </div>

            <div class="project-body">
              <h3 class="project-title"><%= p.projectname %></h3>
              <p class="project-desc"><%= p.projectinfo %></p>

              <div class="project-tech-tags">
                <% if (p.tech && Array.isArray(p.tech)) { %>
                  <% p.tech.forEach(function(t) { %>
                    <span class="tech-tag"><%= t %></span>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <div class="project-footer-actions">
              <a href="<%= p.repo || 'https://github.com/Ankit099-01' %>" target="_blank" class="project-link-btn">
                <i class="fab fa-github"></i> Code Repo
              </a>
              <a href="<%= p.link || '#' %>" class="project-link-btn" style="color: var(--accent-secondary);" onclick="if('<%= p.link %>' === '#' || !'<%= p.link %>') { alert('Live preview active!'); return false; }">
                <i class="fas fa-external-link-alt"></i> Live Demo
              </a>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </section>

  <!-- CERTIFICATIONS & ACHIEVEMENTS -->
  <section class="certifications-section" id="certifications">
    <div class="section-header">
      <span class="section-subtitle">Verified Accomplishments</span>
      <h2 class="section-title">Certifications & <span class="gradient-text-accent">Achievements</span></h2>
    </div>

    <div class="services-grid">
      <div class="glass-card service-card tilt-card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="service-icon" style="background: rgba(99, 102, 241, 0.1); color: #6366f1;">
            <i class="fas fa-brain"></i>
          </div>
          <h3>Artificial Intelligence Fundamentals</h3>
          <p style="font-weight: 600; color: var(--accent-primary); font-size: 0.85rem;">IBM SkillsBuild & Cisco Networking Academy</p>
          <p>Learned core AI concepts including machine learning fundamentals, neural networks, real-world AI applications, and ethical considerations.</p>
        </div>
        <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--glass-border-subtle);">
          <a href="https://www.credly.com/badges/a3d813d9-5960-4040-a165-27323f4106d6/linked_in?t=t1ywtc" target="_blank" class="project-link-btn" style="font-size: 0.85rem; width: fit-content; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fas fa-certificate"></i> Verify / View Certificate <i class="fas fa-arrow-up-right-from-square" style="font-size: 0.75rem;"></i>
          </a>
        </div>
      </div>

      <div class="glass-card service-card tilt-card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="service-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
            <i class="fab fa-aws"></i>
          </div>
          <h3>AWS Academy Cloud Foundations</h3>
          <p style="font-weight: 600; color: var(--accent-primary); font-size: 0.85rem;">AWS Academy</p>
          <p>Foundational knowledge of cloud computing, core AWS services, cloud security, deployment models, and virtualization.</p>
        </div>
        <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--glass-border-subtle);">
          <a href="https://www.credly.com/badges/4dd5e516-a0dc-4efd-953d-9bcfadfc15a6/linked_in?t=t1wt1y" target="_blank" class="project-link-btn" style="font-size: 0.85rem; width: fit-content; display: inline-flex; align-items: center; gap: 8px; color: #f59e0b;">
            <i class="fas fa-certificate"></i> Verify / View Certificate <i class="fas fa-arrow-up-right-from-square" style="font-size: 0.75rem;"></i>
          </a>
        </div>
      </div>

      <div class="glass-card service-card tilt-card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="service-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
            <i class="fas fa-code-compare"></i>
          </div>
          <h3>Design & Analysis of Algorithms</h3>
          <p style="font-weight: 600; color: var(--accent-primary); font-size: 0.85rem;">CodeTantra & LeetCode 100+ Solved</p>
          <p>Algorithm design techniques, space & time complexity (Big-O), and structured problem-solving with 100+ DSA problems solved on LeetCode.</p>
        </div>
        <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--glass-border-subtle);">
          <a href="https://leetcode.com" target="_blank" class="project-link-btn" style="font-size: 0.85rem; width: fit-content; display: inline-flex; align-items: center; gap: 8px; color: #10b981;">
            <i class="fas fa-code"></i> View LeetCode Profile <i class="fas fa-arrow-up-right-from-square" style="font-size: 0.75rem;"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <%- include("include/contact.ejs"); %>

  <!-- Resume Modal -->
  <%- include("include/resume-modal.ejs"); %>

  <!-- Footer -->
  <%- include("include/footer.ejs"); %>

</body>
</html>
