<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MERN Skills & Tech Stack | Ankit Kumar</title>
  <meta name="description" content="Technical skills of Ankit Kumar including MERN Stack (MongoDB, Express, React, Node), Java, Python, C, MySQL, Git, Data Structures.">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

  <!-- Navbar -->
  <%- include("include/navbar.ejs"); %>

  <section class="skills-section" id="skills">
    <div class="section-header">
      <span class="section-subtitle">Verified Technical Stack</span>
      <h2 class="section-title">Skills & <span class="gradient-text-accent">Technologies</span></h2>
      <p class="section-desc">Technologies, frameworks, databases, and core CS subjects from my official resume.</p>
    </div>

    <!-- Category Filter Buttons -->
    <div class="skills-filter">
      <button class="filter-btn active" data-filter="all">All Skills</button>
      <button class="filter-btn" data-filter="frontend">Frontend</button>
      <button class="filter-btn" data-filter="backend">Backend</button>
      <button class="filter-btn" data-filter="languages">Languages</button>
      <button class="filter-btn" data-filter="databases">Databases</button>
      <button class="filter-btn" data-filter="tools">Tools & Core CS</button>
    </div>

    <!-- Skills Grid -->
    <div class="skills-grid">
      <!-- React.js -->
      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #61DAFB; background: #20232a;">
          <i class="fa-brands fa-react"></i>
        </div>
        <span class="skill-title">React.js</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- Node JS -->
      <div class="glass-card skill-card-modern tilt-card" data-category="backend">
        <div class="skill-icon-wrap" style="color: #339933;">
          <i class="fa-brands fa-node-js"></i>
        </div>
        <span class="skill-title">Node.js</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- Express JS -->
      <div class="glass-card skill-card-modern tilt-card" data-category="backend">
        <div class="skill-icon-wrap" style="color: #4f46e5;">
          <i class="fa-solid fa-server"></i>
        </div>
        <span class="skill-title">Express.js</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- MongoDB -->
      <div class="glass-card skill-card-modern tilt-card" data-category="databases">
        <div class="skill-icon-wrap" style="color: #13AA52;">
          <i class="fa-solid fa-database"></i>
        </div>
        <span class="skill-title">MongoDB</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- JavaScript -->
      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #F7DF1E; background: #1e293b;">
          <i class="fa-brands fa-js"></i>
        </div>
        <span class="skill-title">JavaScript</span>
        <span class="skill-level-badge">Advanced</span>
      </div>

      <!-- Java -->
      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #f89820;">
          <i class="fa-brands fa-java"></i>
        </div>
        <span class="skill-title">Java</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- Python -->
      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #3776AB;">
          <i class="fa-brands fa-python"></i>
        </div>
        <span class="skill-title">Python</span>
        <span class="skill-level-badge">Intermediate</span>
      </div>

      <!-- C -->
      <div class="glass-card skill-card-modern tilt-card" data-category="languages">
        <div class="skill-icon-wrap" style="color: #00599C;">
          <i class="fa-solid fa-code"></i>
        </div>
        <span class="skill-title">C Language</span>
        <span class="skill-level-badge">Intermediate</span>
      </div>

      <!-- HTML5 -->
      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #E34F26;">
          <i class="fa-brands fa-html5"></i>
        </div>
        <span class="skill-title">HTML5</span>
        <span class="skill-level-badge">Advanced</span>
      </div>

      <!-- CSS3 -->
      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #1572B6;">
          <i class="fa-brands fa-css3-alt"></i>
        </div>
        <span class="skill-title">CSS3 & Glass</span>
        <span class="skill-level-badge">Advanced</span>
      </div>

      <!-- Bootstrap -->
      <div class="glass-card skill-card-modern tilt-card" data-category="frontend">
        <div class="skill-icon-wrap" style="color: #7952B3;">
          <i class="fa-brands fa-bootstrap"></i>
        </div>
        <span class="skill-title">Bootstrap</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- MySQL -->
      <div class="glass-card skill-card-modern tilt-card" data-category="databases">
        <div class="skill-icon-wrap" style="color: #00758F;">
          <i class="fa-solid fa-database"></i>
        </div>
        <span class="skill-title">MySQL</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- RESTful APIs -->
      <div class="glass-card skill-card-modern tilt-card" data-category="backend">
        <div class="skill-icon-wrap" style="color: #06b6d4;">
          <i class="fa-solid fa-network-wired"></i>
        </div>
        <span class="skill-title">RESTful APIs</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- Git & GitHub -->
      <div class="glass-card skill-card-modern tilt-card" data-category="tools">
        <div class="skill-icon-wrap" style="color: #f05032;">
          <i class="fa-brands fa-git-alt"></i>
        </div>
        <span class="skill-title">Git & GitHub</span>
        <span class="skill-level-badge">Proficient</span>
      </div>

      <!-- Core CS: DSA -->
      <div class="glass-card skill-card-modern tilt-card" data-category="tools">
        <div class="skill-icon-wrap" style="color: #10b981;">
          <i class="fa-solid fa-brain"></i>
        </div>
        <span class="skill-title">DSA (LeetCode 70+)</span>
        <span class="skill-level-badge">Core CS</span>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <%- include("include/contact.ejs"); %>

  <!-- Resume Modal -->
  <%- include("include/resume-modal.ejs"); %>

  <!-- Footer -->
  <%- include("include/footer.ejs"); %>

</body>
</html>